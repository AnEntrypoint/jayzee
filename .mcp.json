{
  "mcpServers": {
    "playwriter": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "github:AnEntrypoint/pw#1488a92",
        "playwriter-project"
      ],
      "env": {
        "PLAYWRITER_TELEMETRY": "0",
        "PLAYWRITER_BROWSER_PATH": "/workspace/jayzee/scripts/browser/chromium-webgpu.sh",
        "BREAKPAD_DUMP_LOCATION": "/workspace/jayzee/.playwriter/crash-dumps"
      },
      "ignore": [
        ".playwriter/"
      ],
      "deny": [
        "reset"
      ],
      "timeoutMs": 300000,
      "startupTimeoutMs": 600000
    }
  }
}
