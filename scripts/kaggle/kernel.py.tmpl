import hashlib, io, json, os, shutil, subprocess, tarfile, time, urllib.request

PAYLOAD_SHA256 = "__PAYLOAD_SHA256__"
PAYLOAD_NAME = "bench.bin"
INPUT = os.environ.get("JAYZEE_BENCH_INPUT", "/kaggle/input")
NODE_VERSION = "24.22.0"
RUN_LIMIT_S = 600
WORK = os.environ.get("JAYZEE_BENCH_WORK", "/tmp/jayzee-bench")
RESULTS = os.environ.get("JAYZEE_BENCH_RESULTS", "/kaggle/working/results.json")
ONLY = os.environ.get("JAYZEE_BENCH_ONLY")


def node_ok(path):
    try:
        out = subprocess.run([path, "--version"], capture_output=True, text=True, timeout=20).stdout.strip()
        return int(out.lstrip("v").split(".")[0]) >= 22
    except Exception:
        return False


def find_node():
    system = shutil.which("node")
    if system and node_ok(system):
        return system
    dest = "/tmp/node-v%s" % NODE_VERSION
    binary = os.path.join(dest, "bin", "node")
    if not node_ok(binary):
        url = "https://nodejs.org/dist/v%s/node-v%s-linux-x64.tar.xz" % (NODE_VERSION, NODE_VERSION)
        data = urllib.request.urlopen(url, timeout=600).read()
        with tarfile.open(fileobj=io.BytesIO(data), mode="r:xz") as archive:
            archive.extractall("/tmp")
        os.rename("/tmp/node-v%s-linux-x64" % NODE_VERSION, dest)
    return binary


def read_payload():
    found = [os.path.join(folder, name) for folder, _, names in os.walk(INPUT) for name in names if name == PAYLOAD_NAME]
    if not found:
        raise FileNotFoundError("no %s under %s" % (PAYLOAD_NAME, INPUT))
    with open(found[0], "rb") as handle:
        data = handle.read()
    digest = hashlib.sha256(data).hexdigest()
    if digest != PAYLOAD_SHA256:
        raise ValueError("stale dataset: %s has sha256 %s, the kernel expects %s" % (found[0], digest, PAYLOAD_SHA256))
    return data


def cpu_fields():
    fields = {}
    with open("/proc/cpuinfo") as handle:
        for line in handle:
            if ":" not in line:
                if fields:
                    break
                continue
            key, value = line.split(":", 1)
            fields[key.strip()] = value.strip()
    return fields


def machine():
    cpu = cpu_fields()
    flags = cpu.get("flags", "").split()
    info = {"vendor": cpu.get("vendor_id"), "family": cpu.get("cpu family"), "model": cpu.get("model"), "stepping": cpu.get("stepping"),
            "modelName": cpu.get("model name"), "mhz": cpu.get("cpu MHz"), "cache": cpu.get("cache size"), "siblings": cpu.get("siblings"),
            "cores": cpu.get("cpu cores"), "bogomips": cpu.get("bogomips"), "avx2": "avx2" in flags, "avx512f": "avx512f" in flags,
            "hypervisor": "hypervisor" in flags, "nproc": os.cpu_count()}
    info["class"] = "%s-%s-%s-%s" % (info["vendor"], info["family"], info["model"], info["stepping"])
    try:
        text = subprocess.run(["lscpu"], capture_output=True, text=True, timeout=20).stdout
        wanted = ("Thread(s) per core", "Core(s) per socket", "Socket(s)", "L1d cache", "L2 cache", "L3 cache", "CPU max MHz", "NUMA node(s)")
        info["lscpu"] = {line.split(":", 1)[0].strip(): line.split(":", 1)[1].strip() for line in text.splitlines() if line.split(":", 1)[0].strip() in wanted}
    except Exception as error:
        info["lscpu"] = {"error": str(error)}
    try:
        with open("/sys/fs/cgroup/cpu.max") as handle:
            info["cgroupCpuMax"] = handle.read().strip()
    except Exception:
        info["cgroupCpuMax"] = None
    return info


def save(results):
    os.makedirs(os.path.dirname(RESULTS), exist_ok=True)
    with open(RESULTS, "w") as handle:
        json.dump(results, handle)


def run_one(node, run):
    args = list(run["args"])
    if run["glueArg"] >= 0:
        args[run["glueArg"]] = os.path.join(WORK, args[run["glueArg"]])
    began = time.time()
    try:
        done = subprocess.run([node] + run["nodeFlags"] + [os.path.join(WORK, run["script"])] + args,
                              capture_output=True, text=True, cwd=WORK, timeout=RUN_LIMIT_S)
        lines = [line[len("RESULT "):] for line in done.stdout.splitlines() if line.startswith("RESULT ")]
        entry = json.loads(lines[-1]) if lines else {"error": "no result", "exit": done.returncode, "stderr": done.stderr[-800:]}
    except subprocess.TimeoutExpired:
        entry = {"error": "timeout after %d s" % RUN_LIMIT_S}
    entry["script"] = run["script"]
    entry["args"] = run["args"]
    entry["nodeFlags"] = run["nodeFlags"]
    entry["probe"] = run["probe"]
    entry["role"] = run.get("role")
    entry["runS"] = round(time.time() - began, 1)
    return entry


def median(values):
    ordered = sorted(values)
    return ordered[len(ordered) // 2]


def summarise(configs):
    groups = {}
    order = []
    for entry in configs:
        key = json.dumps([entry.get("script"), entry.get("args"), entry.get("nodeFlags")])
        if key not in groups:
            groups[key] = []
            order.append(key)
        groups[key].append(entry)
    lines = []
    for key in order:
        rows = groups[key]
        first = rows[0]
        line = {"script": first.get("script"), "args": first.get("args"), "nodeFlags": first.get("nodeFlags"), "role": first.get("role"), "repeats": len(rows)}
        good = [row for row in rows if row.get("kind") == "tick" and not row.get("refused") and not row.get("error")]
        if good:
            line.update({
                "bodies": good[0].get("bodies"), "workers": good[0].get("workers"), "knobs": good[0].get("knobs"), "variant": good[0].get("variant"),
                "p99MedianMs": median([row["p99Ms"] for row in good]), "p99WorstMs": max(row["p99Ms"] for row in good),
                "maxWorstMs": max(row["maxMs"] for row in good),
                "activeMeanMedianMs": median([row.get("activeMeanMs") or 0 for row in good]),
                "overBudgetEach": [row["overBudget"] for row in good], "overBudgetHostEach": [row.get("overBudgetHost") for row in good],
                "lastActiveTick": max((row.get("lastActiveTick") or -1) for row in good),
                "visualSettleTick": max((row.get("visualSettleTick") or -1) for row in good),
                "unsettledViewBodyTicks": max((row.get("unsettledViewBodyTicks") or 0) for row in good),
                "updateErrors": max((row.get("updateErrors") or 0) for row in good),
            })
        else:
            line["results"] = [{name: row.get(name) for name in ("kind", "refused", "error", "status", "singleMs", "memoryMs", "cpuP99Ms", "cpuMaxMs", "cpuOver25", "tier") if row.get(name) is not None} for row in rows]
        lines.append(line)
    return lines


def main():
    started = time.time()
    shutil.rmtree(WORK, ignore_errors=True)
    os.makedirs(WORK)
    with tarfile.open(fileobj=io.BytesIO(read_payload()), mode="r:gz") as archive:
        archive.extractall(WORK)
    with open(os.path.join(WORK, "plan.json")) as handle:
        plan = json.load(handle)
    node = find_node()
    version = subprocess.run([node, "--version"], capture_output=True, text=True).stdout.strip()
    cpu_model = next((line.split(":", 1)[1].strip() for line in open("/proc/cpuinfo") if line.startswith("model name")), "unknown")
    results = {"startedAtEpochS": started, "payloadSha256": PAYLOAD_SHA256, "node": version, "cpuModel": cpu_model, "nproc": os.cpu_count(), "machine": machine(),
               "budgetMs": plan["budgetMs"], "ticks": plan["ticks"], "arenaBudgetBytes": plan["arenaBudgetBytes"],
               "plannedRuns": len(plan["runs"]), "configs": []}
    print("node", version, "cpu", cpu_model, "nproc", os.cpu_count(), "runs", len(plan["runs"]), flush=True)
    runs = plan["runs"] if ONLY is None else [plan["runs"][int(i)] for i in ONLY.split(",")]
    for run in runs:
        entry = run_one(node, run)
        results["configs"].append(entry)
        save(results)
    results["totalS"] = round(time.time() - started, 1)
    results["summary"] = summarise(results["configs"])
    for line in results["summary"]:
        print("CONFIG " + json.dumps(line), flush=True)
    save(results)
    print("DONE", json.dumps({"totalS": results["totalS"], "configs": len(results["configs"])}), flush=True)


main()
