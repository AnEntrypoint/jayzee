  "note": "spoint BlendTree1D, BlendTree2D and BlendTreeNode run on scripts/lib/blendTreeScenario.mjs. The file imports three.js at line 1, but no class in it uses that import, so the import is replaced by an empty module through scripts/lib/threeStubHooks.mjs. AnimationBlender is not in this fixture."
 },
 "sections": {
  "BlendTree1D": [
   "{\"label\":\"1D parameter -1 weights\",\"result\":{\"ok\":[[1,0,0,0],0,0]}}",
   "{\"label\":\"1D parameter 0 weights\",\"result\":{\"ok\":[[1,0,0,0],0,0]}}",
   "{\"label\":\"1D parameter 0.5 weights\",\"result\":{\"ok\":[[0.5,0.5,0,0],0.5,0]}}",
   "{\"label\":\"1D parameter 1 weights\",\"result\":{\"ok\":[[0,1,0,0],1,0]}}",
   "{\"label\":\"1D parameter 2.5 weights\",\"result\":{\"ok\":[[0,0.5,0.5,0],0.5,0]}}",
   "{\"label\":\"1D parameter 4 weights\",\"result\":{\"ok\":[[0,0,1,0],0,0]}}",
   "{\"label\":\"1D parameter 6 weights\",\"result\":{\"ok\":[[0,0,0.5,0.5],0,0]}}",
   "{\"label\":\"1D parameter 8 weights\",\"result\":{\"ok\":[[0,0,0,1],0,0]}}",
   "{\"label\":\"1D parameter 9 weights\",\"result\":{\"ok\":[[0,0,0,1],0,0]}}",
   "{\"label\":\"1D clips after construction\",\"result\":{\"ok\":[{\"clip\":\"idle\",\"threshold\":0},{\"clip\":\"walk\",\"threshold\":1},{\"clip\":\"run\",\"threshold\":4},{\"clip\":\"sprint\",\"threshold\":8}]}}",
   "{\"label\":\"1D empty tree\",\"result\":{\"ok\":[]}}",
   "{\"label\":\"1D addClip chains and weights\",\"result\":{\"ok\":[0.5,0.5]}}",
   "{\"label\":\"1D duplicate thresholds take the high index\",\"result\":{\"ok\":[0,1]}}",
   "{\"label\":\"1D bare object is a clip with threshold 0\",\"result\":{\"ok\":[{\"clip\":{\"name\":\"bare\"},\"threshold\":0}]}}",
   "{\"label\":\"1D getWeights returns a copy\",\"result\":{\"ok\":[[99,1],[0,1]]}}",
   "{\"label\":\"1D null entry is refused\",\"result\":{\"threw\":\"[BlendTree1D] clips[0] is null; pass a clip or build the tree with addClip(clip, threshold)\"}}",
   "{\"label\":\"1D entry without a clip is refused\",\"result\":{\"ok\":{\"clips\":[{\"clip\":{\"threshold\":1},\"threshold\":0}],\"weights\":[0],\"parameter\":0}}}",
   "{\"label\":\"1D addClip with null clip is refused\",\"result\":{\"threw\":\"[BlendTree1D] clips[0] names no clip\"}}",
   "{\"label\":\"1D entry with null clip is refused\",\"result\":{\"threw\":\"[BlendTree1D] clips[1] names no clip\"}}"
  ],
  "BlendTree2D": [
