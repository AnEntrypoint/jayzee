   "{\"label\":\"2D (0.25, 0.1) weights\",\"result\":{\"ok\":[[0.6082270110247872,0.17532828652330584,0.21644470245190697,0],0.6082270110247872,0]}}",
   "{\"label\":\"2D (10, 10) weights\",\"result\":{\"ok\":[[0,0.3271163205268436,0.3271163205268436,0.3457673589463127],0,0]}}",
   "{\"label\":\"2D (0.001, 0) weights\",\"result\":{\"ok\":[[0.9803825404537897,0.00980382050262887,0.00981363904358148,0],0.9803825404537897,0]}}",
   "{\"label\":\"2D (0.004, 0.003) weights\",\"result\":{\"ok\":[[0.9803247598757567,0.00983266670115082,0.009842573423092561,0],0.9803247598757567,0]}}",
   "{\"label\":\"2D (-0.5, 0.5) weights\",\"result\":{\"ok\":[[0.4086280011842216,0.4086280011842216,0.18274399763155683,0],0.4086280011842216,0]}}",
   "{\"label\":\"2D (0.5, 0) weights\",\"result\":{\"ok\":[[0.4086280011842216,0.1827439976315568,0.4086280011842216,0],0.4086280011842216,0]}}",
   "{\"label\":\"2D clips after construction\",\"result\":{\"ok\":[{\"clip\":\"idle\",\"x\":0,\"y\":0},{\"clip\":\"north\",\"x\":0,\"y\":1},{\"clip\":\"east\",\"x\":1,\"y\":0},{\"clip\":\"north-east\",\"x\":1,\"y\":1}]}}",
   "{\"label\":\"2D empty tree\",\"result\":{\"ok\":[]}}",
   "{\"label\":\"2D addClip defaults to the origin\",\"result\":{\"ok\":[0,1]}}",
   "{\"label\":\"2D two samples use both\",\"result\":{\"ok\":[0.75,0.25]}}",
   "{\"label\":\"2D nearest three of five on a line\",\"result\":{\"ok\":[0.14634146341463414,0.5121951219512195,0.34146341463414626,0,0]}}",
   "{\"label\":\"2D equal distances keep the listed order\",\"result\":{\"ok\":[0.4086280011842216,0.1827439976315568,0.4086280011842216,0]}}",
   "{\"label\":\"2D null entry is refused\",\"result\":{\"threw\":\"[BlendTree2D] clips[0] is null; pass a clip or build the tree with addClip(clip, x, y)\"}}",
   "{\"label\":\"2D entry without a clip is refused\",\"result\":{\"ok\":{\"clips\":[{\"clip\":{\"x\":0,\"y\":0},\"x\":0,\"y\":0}],\"weights\":[0],\"posX\":0,\"posY\":0}}}",
   "{\"label\":\"2D addClip with null clip is refused\",\"result\":{\"threw\":\"[BlendTree2D] clips[0] names no clip\"}}"
  ],
  "BlendTreeNode": [
   "{\"label\":\"node initial state\",\"result\":{\"ok\":{\"name\":\"root\",\"children\":0,\"output\":0}}}",
   "{\"label\":\"addChild returns the node\",\"result\":{\"ok\":true}}",
   "{\"label\":\"addChild chains and accepts a child without update\",\"result\":{\"ok\":3}}",
   "{\"label\":\"update forwards dt to children with update only\",\"result\":{\"ok\":[\"a 0.5\",\"b 0.5\"]}}",
   "{\"label\":\"default name and children\",\"result\":{\"ok\":[\"\",[],0]}}",
   "{\"label\":\"children array is shared with the argument\",\"result\":{\"ok\":1}}"
  ]
 }
