    {
      "label": "a full player record reexpresses every field and clears the wall planes",
      "kind": "player",
      "input": {
        "position": [
          1,
          2,
          3
        ],
        "velocity": [
          0,
          -1,
          0
        ],
        "rotation": 0.5,
        "lookYaw": 0.1,
        "lookPitch": -0.2,
        "groundNormal": [
          0,
          1,
          0
        ],
        "wallPlanes": [
          {
            "n": [
              1,
              0,
              0
            ]
          },
          {
            "n": [
              0,
              0,
              1
            ]
          }
        ]
      },
      "expect": {
        "trace": [
