            "point",
            [
              1,
              2,
              3
            ]
          ],
          [
            "vector",
            [
              0,
              -1,
              0
            ]
          ],
          [
            "yawRotation",
            0.5
          ],
          [
            "look",
            "<subject>",
            "lookYaw",
            "lookPitch"
          ],
          [
            "vector",
            [
              0,
              1,
              0
            ]
          ]
        ],
        "hasWallPlanes": true,
        "wallPlanes": []
      }
