{
  "name": "jayzee",
  "version": "0.2.0",
  "description": "Deterministic physics for multiplayer games: numeric kernels compiled through jz to WebAssembly, with a plain JavaScript host",
  "type": "module",
  "types": "./types/index.d.ts",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "types/",
    "dist/kernel.wasm",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:kernel": "node scripts/build-kernel.mjs",
    "test": "npm run build:kernel && npm run check:kernel && npm run check:world && npm run check:protocol && npm run check:messages && npm run check:netcode && npm run check:snapshots && npm run check:spawn && npm run check:types",
    "check:types": "tsc -p tsconfig.json",
    "bench": "node scripts/bench.mjs",
    "prepare": "npm run build:kernel",
    "prepack": "npm run build:kernel",
    "check:netcode": "node scripts/check-netcode.mjs",
    "check:snapshots": "node scripts/check-snapshots.mjs",
    "check:kernel": "node scripts/check-kernel.mjs",
    "check:world": "node scripts/check-world.mjs",
    "check:protocol": "node scripts/check-protocol.mjs",
    "check:messages": "node scripts/check-messages.mjs",
    "check:spawn": "node scripts/check-spawn.mjs"
  },
  "dependencies": {
    "jz": "1.0.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "license": "UNLICENSED"
}
